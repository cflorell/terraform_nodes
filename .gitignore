# Terraform working directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan output
*.tfplan
*.plan

# Local variable files can contain secrets
*.tfvars
*.tfvars.json

# Remote state backend config contains an access token
backend.hcl

# CI plan summary
tfplan.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Local Terraform CLI config
.terraformrc
terraform.rc

# Private-file helper backups
*.private-backup-*

# Trivy
trivy-iac-report.json